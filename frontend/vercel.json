{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.westernbakery.in/admin",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "admin.westernbakery.in"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
